# Скопируйте в .env и впишите токен от @BotFather.
#   cp .env.example .env && chmod 600 .env
#
# Файл .env в git не попадает (см. .gitignore) и не должен быть доступен
# другим пользователям системы: права 600, владелец — пользователь бота.
TELEGRAM_BOT_TOKEN=

# Номера чатов, которым доступна команда /stats со сводкой по аудитории.
# Обычно это ваш чат с ботом; можно перечислить несколько через запятую.
# Узнать номер: напишите боту /stats и посмотрите в лог строку «Чат N
# просил статистику, но его нет в ADMIN_CHAT_ID».
ADMIN_CHAT_ID=

# Где хранить анкеты клиентов (имя, дата, время и город рождения).
# По умолчанию — папка store/ внутри проекта. Меняйте, если персональные
# данные должны лежать на отдельном диске или разделе с шифрованием.
# STORE_DIR=/var/lib/tarot-astro-bot

# Платная модель. Пока переменной нет или она не равна 1, бот работает как
# раньше: разборы бесплатны для всех, но счётчик уже ведётся — к запуску
# продаж будет видно реальное распределение.
# PAYWALL=1

# Сколько разборов по темам человек получает бесплатно за всё время.
# Прогнозы, натальная карта, транзиты и карта дня бесплатны всегда.
# FREE_READINGS=1

# Цена одного разбора в звёздах Telegram. Наборы считаются от неё: три
# разбора без скидки, пять со скидкой 5%, десять — 10%. Цифровые услуги
# Telegram разрешает продавать только за звёзды, поэтому другого способа
# оплаты у бота нет и не будет.
# STAR_PRICE=50

# Кто продаёт — для оферты (команда /terms). По российскому праву при
# продажах нужно назвать себя: «Иванова И. И., самозанятая» или
# «ИП Иванова И. И., ИНН ...». Пока переменной нет, оферта говорит
# только то, что заведомо правда: услугу оказывает владелец бота.
# SELLER_CONTACT — куда писать по вопросам оплаты, возврата и данных.
# Без него бот зовёт писать прямо в чат с ним: личный ник в коде не
# хранится, потому что код уезжает в репозиторий и к другим людям.
# SELLER_NAME=Иванова И. И., самозанятая
# SELLER_CONTACT=@ваш_ник

# Адрес мини-приложения — публичный, по HTTPS, с настоящим сертификатом.
# Telegram другого не принимает. Адрес прописывается в кнопку меню и во все
# кнопки, уже отправленные людям: менять его нельзя, сломаются старые.
# WEBAPP_URL=https://app.вашдомен.ru

# На каком адресе слушает само приложение. По умолчанию 127.0.0.1 — наружу
# оно смотрит через Caddy (см. deploy/Caddyfile), и это единственный
# правильный вариант на сервере. Менять только для проверки с телефона в
# домашней сети.
# WEBAPP_HOST=0.0.0.0
# WEBAPP_PORT=8080
