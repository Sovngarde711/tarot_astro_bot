# Секреты — токен бота. Никогда не коммитить: попав в историю git, он
# остаётся там навсегда, а публичные репозитории сканируются ботами за минуты.
.env
.env.*
!.env.example

# Виртуальное окружение (гигабайты, в том числе torch)
venv/
.venv/

# Статистика: поток событий и соль для хеширования. Соль — секрет:
# с ней хеши чатов перестают быть анонимными.
stats/

# Сохранённые анкеты клиентов: персональные данные, которым не место
# ни в репозитории, ни в бэкапе кода.
store/

# Кеш моделей Hugging Face, если он лежит внутри проекта
.cache/

# Векторная база — пересобирается скриптами из data/
vectorstore/chroma/
vectorstore/documents.json
vectorstore/*.joblib

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Системное
.DS_Store
Thumbs.db
*.log

# Разовые выводы проверок: примеры разборов и выписки формулировок,
# которые скрипты кладут в корень. Полезны, пока смотришь глазами,
# но это не часть проекта — и внутри лежат придуманные анкеты.
sample_*.txt
grammar_*.txt
