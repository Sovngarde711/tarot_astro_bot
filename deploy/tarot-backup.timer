[Unit]
Description=Ежедневный бэкап данных бота

[Timer]
# Ночью, когда никто не пишет боту. Разброс в 10 минут — чтобы бэкап не
# начинался ровно в одну и ту же секунду с другими задачами сервера
OnCalendar=*-*-* 04:17:00
RandomizedDelaySec=600
# Если сервер был выключен в это время — сделать бэкап при включении
Persistent=true

[Install]
WantedBy=timers.target
